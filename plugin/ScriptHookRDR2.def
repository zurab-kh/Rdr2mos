; Import definitions for ScriptHookRDR2.dll (Alexander Blade's Script Hook RDR2).
; An import library is generated from this file at build time, so the Script Hook SDK
; is not needed to build the plugin. Only the functions the plugin uses are listed.
LIBRARY ScriptHookRDR2.dll
EXPORTS
    "?scriptRegister@@YAXPEAUHINSTANCE__@@P6AXXZ@Z"
    "?scriptUnregister@@YAXPEAUHINSTANCE__@@@Z"
    "?scriptWait@@YAXK@Z"
    "?nativeInit@@YAX_K@Z"
    "?nativePush64@@YAX_K@Z"
    "?nativeCall@@YAPEA_KXZ"
    "?worldGetAllPeds@@YAHPEAHH@Z"
    "?worldGetAllVehicles@@YAHPEAHH@Z"
