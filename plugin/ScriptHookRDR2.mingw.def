; MinGW flavour of ScriptHookRDR2.def. The GNU assembler cannot spell MSVC-decorated C++
; names, so the import library exposes plain C names (left) bound to the DLL's real
; export names (right). Keep the two .def files in sync.
LIBRARY ScriptHookRDR2.dll
EXPORTS
    sh_scriptRegister == "?scriptRegister@@YAXPEAUHINSTANCE__@@P6AXXZ@Z"
    sh_scriptUnregister == "?scriptUnregister@@YAXPEAUHINSTANCE__@@@Z"
    sh_scriptWait == "?scriptWait@@YAXK@Z"
    sh_nativeInit == "?nativeInit@@YAX_K@Z"
    sh_nativePush64 == "?nativePush64@@YAX_K@Z"
    sh_nativeCall == "?nativeCall@@YAPEA_KXZ"
    sh_worldGetAllPeds == "?worldGetAllPeds@@YAHPEAHH@Z"
